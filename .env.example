# Public URL of the live site (canonical links, sitemap, social cards).
# Production builds default to https://stgincs.com; set this only to override.
NEXT_PUBLIC_SITE_URL=https://stgincs.com

# Quote form email delivery (https://resend.com). Without these, the form
# tells visitors to call instead of silently dropping their request.
RESEND_API_KEY=
QUOTE_TO_EMAIL=admin@stgincs.com
# Sender must be on a domain verified in Resend (add stgincs.com there first).
QUOTE_FROM_EMAIL="STG Website <website@stgincs.com>"
