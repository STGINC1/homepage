# Public URL of the live site (canonical links, sitemap, social cards).
# Production builds default to https://stgincs.com; set this only to override.
NEXT_PUBLIC_SITE_URL=https://stgincs.com

# Quote form and SMS opt-in email delivery (https://web3forms.com).
# Enter admin@stgincs.com on web3forms.com to get a free access key by email.
# The key is public by design: it can only send to the inbox it was made for.
# Without it, the forms tell visitors to call instead of silently dropping requests.
WEB3FORMS_KEY=
